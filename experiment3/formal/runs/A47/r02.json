en a left turn is needed to face the object\n        # But we don't know the path — instead, use the final frame's heading\n        # Final bearing is the one we're facing at endpoint\n        final_heading = heading1\n        if final_heading > 0:\n            return frame, \"right\", {}\n        else:\n            return frame, \"left\", {}\n    else:\n        # No point, use match score\n        match0, match1 = tools.match()\n        frame = 1 if match1 > match0 else 0\n        heading = heading1 if frame == 1 else heading0\n        return frame, \"right\" if heading > 0 else \"left\", {}\n",
