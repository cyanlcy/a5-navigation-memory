 "diff": "--- \n+++ \n@@ -1,5 +1,25 @@\n def decide(observation, tools):\n-    scores = tools.match()\n-    frame = int(scores[1] > scores[0])\n-    heading = observation[\"views\"][frame][\"heading\"]\n-    return frame, \"right\" if heading > 0 else \"left\", {\"heading\": heading}\n+    views = observation['views']\n+    frame0 = views[0]\n+    frame1 = views[1]\n+    \n+    # Use match score to pick the more similar frame\n+    match_scores = tools.match()\n+    frame = 1 if match_scores[1] > match_scores[0] else 0\n+    \n+    # Get the heading from the selected frame\n+    heading = views[frame]['heading']\n+    \n+    # Use point data to estimate lateral offset if available\n+    point_data = tools.point()\n+    if point_data[1] is not None:  # Only use second frame point\n+        x_frac, y_frac = point_data[1]\n+        # If we have a point, we can infer the object's position\n+        # But since we don't have full calibration or distance, we rely on heading\n+        # The key insight: the object's lateral position relative to endpoint\n+        # is affected by the old heading. We use the heading to decide turn.\n+        \n+    # If the heading is positive, turn right; otherwise, turn left\n+    turn = \"right\" if heading > 0 else \"left\"\n+    \n+    return frame, turn, {\"heading\": heading}\n",
