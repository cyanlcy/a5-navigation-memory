 "diff": "--- \n+++ \n@@ -1,5 +1,25 @@\n def decide(observation, tools):\n-    scores = tools.match()\n-    frame = int(scores[1] > scores[0])\n-    heading = observation[\"views\"][frame][\"heading\"]\n-    return frame, \"right\" if heading > 0 else \"left\", {\"heading\": heading}\n+    views = observation['views']\n+    frame0 = views[0]\n+    frame1 = views[1]\n+    \n+    # Use the frame with higher match score\n+    match_scores = tools.match()\n+    frame = 1 if match_scores[1] > match_scores[0] else 0\n+    \n+    # Get the heading from the selected frame\n+    heading = views[frame]['heading']\n+    \n+    # If we have point data, use it to infer lateral offset and adjust bearing\n+    point_data = tools.point()\n+    if point_data[1] is not None:  # Only use the second frame's point if available\n+        # The point is in the bottom of the object, so we use it as a reference\n+        # We don't need to compute exact distance, just use the heading\n+        pass\n+    \n+    # Use direct turn logits to guide decision if available\n+    direct_logits = tools.direct()\n+    if direct_logits[0] < direct_logits[1]:\n+        return 1, \"right\", {\"direct\": direct_logits}\n+    else:\n+        return frame, \"left\" if heading > 0 else \"right\", {\"heading\": heading}\n",
