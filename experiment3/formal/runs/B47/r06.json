 "source": "def decide(observation, tools):\n    views = observation['views']\n    frame0, frame1 = views[0], views[1]\n    heading0, heading1 = frame0['heading'], frame1['heading']\n    right_of_end0, right_of_end1 = frame0['right_of_end_m'], frame1['right_of_end_m']\n    forward_of_end0, forward_of_end1 = frame0['forward_of_end_m'], frame1['forward_of_end_m']\n    \n    point0, point1 = tools.point()\n    \n    # Prefer point data if available\n    if point0 is not None and point1 is not None:\n        frac0, frac1 = point0[0], point1[0]\n        if abs(frac0 - frac1) < 0.01:\n            # Same horizontal position: use the final heading's sign\n            return 1, \"right\" if heading1 > 0 else \"left\", {\"heading\": heading1}\n        elif frac0 > frac1:\n            return 0, \"right\" if heading0 > 0 else \"left\", {\"heading\": heading0}\n        else:\n            return 1, \"right\" if heading1 > 0 else \"left\", {\"heading\": heading1}\n    elif point0 is not None:\n        return 0, \"right\" if heading0 > 0 else \"left\", {\"heading\": heading0}\n    elif point1 is not None:\n        return 1, \"right\" if heading1 > 0 else \"left\", {\"heading\": heading1}\n    else:\n        # No point data: use match scores\n        match_scores = tools.match()\n        frame = 1 if match_scores[1] > match_scores[0] else 0\n        # Use the final heading's sign for consistency\n        return frame, \"right\" if heading1 > 0 else \"left\", {\"heading\": heading1}\n",
