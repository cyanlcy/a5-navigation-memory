 "diff": "--- \n+++ \n@@ -1,5 +1,18 @@\n def decide(observation, tools):\n-    scores = tools.match()\n-    frame = int(scores[1] > scores[0])\n+    # Use match score to decide which frame is more likely to have the target\n+    match_scores = tools.match()\n+    frame = 1 if match_scores[1] > match_scores[0] else 0\n+    \n+    # Get the heading from the selected frame\n     heading = observation[\"views\"][frame][\"heading\"]\n-    return frame, \"right\" if heading > 0 else \"left\", {\"heading\": heading}\n+    \n+    # Check if we have point data in the selected frame\n+    point_data = tools.point()\n+    if point_data[frame] is not None:\n+        # Use point to get relative position, which helps infer lateral shift\n+        # But we don't have full coordinate system, so we rely on heading sign\n+        # If heading is positive (right), turn right; if negative (left), turn left\n+        return frame, \"right\" if heading > 0 else \"left\", {}\n+    \n+    # If no point, still use heading sign as primary decision\n+    return frame, \"right\" if heading > 0 else \"left\", {}\n",
