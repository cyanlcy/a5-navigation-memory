 "diff": "--- \n+++ \n@@ -1,5 +1,29 @@\n def decide(observation, tools):\n-    scores = tools.match()\n-    frame = int(scores[1] > scores[0])\n-    heading = observation[\"views\"][frame][\"heading\"]\n-    return frame, \"right\" if heading > 0 else \"left\", {\"heading\": heading}\n+    views = observation['views']\n+    frame0 = views[0]\n+    frame1 = views[1]\n+    \n+    # Use match score to decide which frame is more similar to target\n+    match_scores = tools.match()\n+    frame = 1 if match_scores[1] > match_scores[0] else 0\n+    \n+    # Get the heading from the selected frame\n+    heading = views[frame]['heading']\n+    \n+    # If we have point data, use it to infer lateral offset\n+    point_data = tools.point()\n+    if point_data[0] is not None:\n+        # Use the point in the second frame as a more reliable indicator\n+        # If point is present, assume it's in the final view\n+        # We don't use the point directly for turning, but use the heading\n+        pass\n+    \n+    # Use direct turn logits to decide turn direction\n+    direct_scores = tools.direct()\n+    turn_dir = \"right\" if direct_scores[0] > direct_scores[1] else \"left\"\n+    \n+    # Final decision: use direct if available, otherwise fall back to heading sign\n+    if direct_scores[0] > direct_scores[1]:\n+        return frame, turn_dir, {\"direct_score\": direct_scores}\n+    else:\n+        return frame, \"right\" if heading > 0 else \"left\", {\"heading\": heading}\n",
